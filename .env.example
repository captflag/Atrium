# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# SECURITY.md §4 (M0): no secret in this file has a working default. Every
# value here is development-only. Production supplies these from a secret
# store, and the model-provider credential (D1) will live only on the host
# broker — never in a container's environment.

# Postgres. Matches docker-compose.yml defaults for local development.
DATABASE_URL=postgres://atrium:atrium_dev_only@127.0.0.1:5432/atrium

# API server.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Sandbox (M2) ---
# Docker engine endpoint. Defaults to //./pipe/dockerDesktopLinuxEngine on
# Windows and /var/run/docker.sock elsewhere. Docker Desktop for Windows also
# exposes the classic //./pipe/docker_engine, which on some installs points at
# the Windows-containers engine — not the one any of this runs on.
# DOCKER_SOCKET=//./pipe/dockerDesktopLinuxEngine

# Host directory holding one checkout per workspace, bind-mounted into that
# workspace's container. Defaults to <repo>/.atrium/workspaces. The path is
# resolved from HERE plus the workspace id and never from a request
# (SECURITY.md T5).
# ATRIUM_WORKSPACES_DIR=

# Workspace container image. Build it first:
#   docker build -f docker/workspace.Dockerfile -t atrium/workspace-base:m2 .
#   docker image inspect --format "{{.Id}}" atrium/workspace-base:m2
# Set the digest to pin the image by content (SECURITY.md T12). Without it the
# server resolves the tag to its local image id once at first use and warns that
# the pin came from a mutable tag.
# ATRIUM_WORKSPACE_IMAGE=atrium/workspace-base
# ATRIUM_WORKSPACE_IMAGE_TAG=m2
# ATRIUM_WORKSPACE_IMAGE_DIGEST=

# Public HTTPS repository cloned into an empty workspace checkout. Unset means
# the workspace starts empty. PUBLIC ONLY: no credential of any kind enters a
# container, so private repos wait for the host-side Git proxy (D2, M6).
# ATRIUM_REPO_URL=https://github.com/octocat/Hello-World.git

# --- Not used yet ---
# Model provider credential. Deliberately unset: the harness and provider are
# undecided (PLAN.md §10.0), and when they are chosen this value belongs to the
# host-side broker only (SECURITY.md D1).
# MODEL_PROVIDER_API_KEY=
# MODEL_PROVIDER_BASE_URL=
