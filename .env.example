# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# SECURITY.md §4 (M0): no secret in this file has a working default. Every
# value here is development-only. Production supplies these from a secret
# store, and the model-provider credential (D1) will live only on the host
# broker — never in a container's environment.

# Postgres. Matches docker-compose.yml defaults for local development.
DATABASE_URL=postgres://atrium:atrium_dev_only@127.0.0.1:5432/atrium

# API server.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Sandbox (M2) ---
# Docker engine endpoint. Defaults to //./pipe/dockerDesktopLinuxEngine on
# Windows and /var/run/docker.sock elsewhere. Docker Desktop for Windows also
# exposes the classic //./pipe/docker_engine, which on some installs points at
# the Windows-containers engine — not the one any of this runs on.
# DOCKER_SOCKET=//./pipe/dockerDesktopLinuxEngine

# Host directory holding one checkout per workspace, bind-mounted into that
# workspace's container. Defaults to <repo>/.atrium/workspaces. The path is
# resolved from HERE plus the workspace id and never from a request
# (SECURITY.md T5).
# ATRIUM_WORKSPACES_DIR=

# Workspace container image. Build it first:
#   docker build -f docker/workspace.Dockerfile -t atrium/workspace-base:m2 .
#   docker image inspect --format "{{.Id}}" atrium/workspace-base:m2
# Set the digest to pin the image by content (SECURITY.md T12). Without it the
# server resolves the tag to its local image id once at first use and warns that
# the pin came from a mutable tag.
# ATRIUM_WORKSPACE_IMAGE=atrium/workspace-base
# ATRIUM_WORKSPACE_IMAGE_TAG=m2
# ATRIUM_WORKSPACE_IMAGE_DIGEST=

# Public HTTPS repository cloned into an empty workspace checkout. Unset means
# the workspace starts empty. PUBLIC ONLY: no credential of any kind enters a
# container, so private repos wait for the host-side Git proxy (D2, M6).
# ATRIUM_REPO_URL=https://github.com/octocat/Hello-World.git

# --- Model broker + agents (M3) ---
# The broker sidecar is a container, one per workspace, on the same --internal
# bridge the workspace sits on. IT holds the provider credential; the workspace
# container gets only the broker's URL and a capability token (SECURITY.md D1).
# Build it first:
#   npm run build --workspace @atrium/broker
#   docker build -f docker/broker.Dockerfile -t atrium/broker:m3 .
# ATRIUM_BROKER_IMAGE=atrium/broker
# ATRIUM_BROKER_IMAGE_TAG=m3
# ATRIUM_BROKER_PORT=8900

# The model API the broker forwards to. Defaults to https://api.anthropic.com.
# A single-label http host (a stub container on the internal bridge) is assumed
# to need no egress; anything else gets a routable network. ATRIUM_BROKER_EGRESS
# ("on"/"off") overrides that inference.
# ATRIUM_UPSTREAM_ORIGIN=https://api.anthropic.com
# ATRIUM_BROKER_EGRESS=

# THE PROVIDER CREDENTIAL. It is read here and handed to the broker sidecar at
# container-create time, and it goes nowhere else — never into a workspace
# container, a spec, an event, or a log line. Leaving it unset is a supported
# state: the broker still authenticates the capability token, enforces the path
# allowlist and enforces the budget, and refuses to forward. That is how
# scripts/probe-broker.mjs and scripts/probe-agent.mjs prove the boundary on a
# machine holding no key at all.
# ATRIUM_UPSTREAM_API_KEY=

# Cumulative token ceiling per broker sidecar, enforced OUTSIDE the container
# (SECURITY.md T10), and the capability token's claimed lifetime.
# ATRIUM_SESSION_TOKEN_BUDGET=2000000
# ATRIUM_BROKER_TOKEN_TTL_MS=43200000

# Agent policy. Model choice is per-need (PLAN.md 10.0): the strong model for
# coding, the cheap one for mechanical background work. Never one model
# everywhere. Effort is low|medium|high|xhigh.
# ATRIUM_AGENT_MODEL=claude-opus-5
# ATRIUM_AGENT_EFFORT=high
# ATRIUM_AGENT_FALLBACK_MODEL=
# ATRIUM_AGENT_BACKGROUND_MODEL=claude-haiku-4-5
# ATRIUM_AGENT_BACKGROUND_EFFORT=low
# ATRIUM_AGENT_MAX_TURNS=24
# ATRIUM_AGENT_TURN_TIMEOUT_MS=600000
# ATRIUM_AGENT_MAX_COST_USD=
# ATRIUM_MAX_AGENTS_PER_WORKSPACE=4

# Tool policy handed to the harness. ADVISORY, never a boundary (D5, T7):
# it runs inside the agent's own process. Comma-separated.
# ATRIUM_AGENT_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,NotebookEdit,Bash,TodoWrite,Task
# ATRIUM_AGENT_DENIED_TOOLS=WebFetch,WebSearch
# ATRIUM_AGENT_SYSTEM_PROMPT=

# --- Superseded ---
# Replaced by ATRIUM_UPSTREAM_API_KEY / ATRIUM_UPSTREAM_ORIGIN above, which name
# the broker sidecar rather than a provider the server itself would call.
# MODEL_PROVIDER_API_KEY=
# MODEL_PROVIDER_BASE_URL=
